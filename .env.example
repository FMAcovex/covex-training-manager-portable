# Desarrollo local: mantener APP_ENV=development y AUTH_MODE=demo.
APP_ENV="development"
AUTH_MODE="demo"

# PostgreSQL. Obligatoria cuando APP_ENV=production o cuando Azure App Service está activo.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/covex_training?sslmode=require"

# SharePoint/Microsoft Graph queda deshabilitado hasta que IT proporcione la ubicación corporativa.
SHAREPOINT_ENABLED="false"
SHAREPOINT_SITE_ID=""
SHAREPOINT_DRIVE_ID=""

# Solo para ejecutar manualmente pnpm db:bootstrap-admin durante la implantación inicial.
BOOTSTRAP_ADMIN_ENTRA_OBJECT_ID=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_DISPLAY_NAME=""

# Servidor privado H9A: AUTH_MODE=entra-proxy. Ver deploy/production.env.example.
# ENTRA_TENANT_ID=<UUID del tenant>
# ENTRA_CLIENT_ID=<UUID de la aplicación>
# AUTH_PROXY_SECRET=<64 caracteres hexadecimales aleatorios>

# H10A portable: aplicación pública Entra (Authorization Code + PKCE, sin secreto).
PORTABLE_ENTRA_TENANT_ID=""
PORTABLE_ENTRA_CLIENT_ID=""
PORTABLE_ENTRA_REDIRECT_URI="http://127.0.0.1:43110/portable-poc"

# Identificadores no secretos de los recursos aprobados por IT para el POC.
PORTABLE_SHAREPOINT_SITE_ID=""
PORTABLE_SHAREPOINT_TRAININGS_LIST_ID=""
PORTABLE_SHAREPOINT_DOCUMENT_DRIVE_ID=""
