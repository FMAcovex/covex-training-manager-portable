# Copiar a deploy/.env.production, acceso exclusivo de IT. Nunca versionar.
# Generar secretos con: node scripts/deployment/init-env.mjs
APP_IMAGE=covex-training-manager:h9a
PUBLIC_HOST=formaciones.covex.example
APP_PUBLIC_URL=https://formaciones.covex.example
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
TLS_DIRECTORY=./tls
POSTGRES_DB=covex_training
POSTGRES_USER=covex
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_64
AUTH_PROXY_SECRET=REPLACE_WITH_RANDOM_HEX_64
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_WITH_RANDOM_BASE64_32_BYTES
ENTRA_TENANT_ID=REPLACE_WITH_TENANT_UUID
ENTRA_CLIENT_ID=REPLACE_WITH_APP_UUID
ENTRA_CLIENT_SECRET=REPLACE_WITH_SECRET
